# Copy this file to .env and replace the sample values.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=EventFlow@2026
FLASK_DEBUG=false
# Set true only after deploying your site with HTTPS.
COOKIE_SECURE=false

# Optional SMTP configuration for attendee alerts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_SENDER=your-email@gmail.com
SMTP_USE_SSL=false

# Optional Gemini integration for AI Insights.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
